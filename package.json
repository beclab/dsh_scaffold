{
  "name": "dshscaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch packages/service/index.ts",
    "build": "tsc -p tsconfig.server.json",
    "start": "node dist/service/index.js",
    "preflight": "scripts/preflight.sh",
    "deploy": "scripts/deploy.sh",
    "skills:sync": "scripts/sync-olares-skills.sh",
    "agent:install": "node __agent__/install.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-base": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-web-app": "^0.1.1-rc.2",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
