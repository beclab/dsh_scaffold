{
  "name": "dshscaffold",
  "title": "DSH Scaffold",
  "image_base_tag": "3",
  "chart_dir": "deploy/dshscaffold",
  "image": {
    "dockerfile": "Dockerfile",
    "dockerfile_base": "Dockerfile.base",
    "context": ".",
    "base_arg": "BASE_IMAGE"
  },
  "hot_reload": {
    "source_subpath": "devsrc",
    "deploy": "dshscaffold",
    "container": "dshscaffold",
    "chown": "1000:1000",
    "reload_sentinel": "",
    "health": {
      "runtime": "node",
      "url": "http://127.0.0.1:8080/api/health"
    },
    "excludes": [
      ".git/",
      "node_modules/",
      "deploy/",
      "scripts/",
      ".env",
      ".env.*",
      "packages/skills/olares-*/",
      "packages/skills/.olares-cli-suite"
    ],
    "scopes": {
      "all": {
        "maps": [
          {
            "src": "./",
            "dest": "./"
          }
        ],
        "watch": [
          "."
        ]
      }
    }
  }
}
