# Copy to .env. After you log in (gh auth login, olares-cli profile login)
# in your own terminal, leave IMAGE_REPO empty — it is derived from your
# GitHub fork: ghcr.io/<you>/<OLARES_APP_ID>.
OLARES_APP_ID=dshscaffold
PRODUCT_NAME=DSH Scaffold
# IMAGE_REPO=ghcr.io/you/dshscaffold

PORT=8080
HOSTNAME=0.0.0.0
LLM_GATEWAY_URL=http://127.0.0.1:11434/v1
# LLM_GATEWAY_FALLBACK_URL=https://llmgatewayv3.example.com/v1
# MODEL_CONSOLE_URL=http://127.0.0.1:8081/v1
# MODEL_CONSOLE_APPS=llamacppqwen3827bggufv3
# OLARES_SYS_VERSION=1.12.6
# DSH_ROUTER_API_KEY=
DSH_WORKSPACE=.dsh/workspace
DSH_DATA_DIR=.dsh/data
# DSH_CLI_ROOT=.dsh/cli
# HOME=.dsh/home
# DSH_MODEL=default
# DSH_TRUSTED_HOSTS=
